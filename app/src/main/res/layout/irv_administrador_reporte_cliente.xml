<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foregroundGravity="center_horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/img"
                android:layout_width="100dp"
                android:layout_height="100sp"
                app:srcCompat="@drawable/admin_foto"
                android:scaleType="centerCrop"
                />
            <LinearLayout
                android:layout_width="160dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">
                <TextView
                    android:id="@+id/nombreCliente"
                    android:text="#Nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:textColor="@color/light_green"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ultimo Pedido"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-condensed"
                    />

                <TextView
                    android:id="@+id/fechaUltimoPedido"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-condensed"
                    android:text="12/22/12"
                    android:textColor="@color/black"
                    />
                <!--
                                <TextView
                                    android:id="@+id/viewDetails"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16sp"
                                    android:fontFamily="sans-serif-condensed"
                                    android:text="Ver detalle"
                                    android:textColor="@color/light_green"
                                   />
                                   -->
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:layout_width="50sp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12sp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="Total de Pedidos"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cantidadPedidos"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:textColor="@color/light_green"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    android:textSize="16dp"/>
                <!--
                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/cantidadVendida"
                    android:layout_width="70dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_height="wrap_content"
                    android:text="300"
                    />
                    -->
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="50sp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14sp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:text="Total (S/.)"
                    android:textAlignment="center"
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300"
                    android:id="@+id/gastoTotal"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:textColor="@color/light_green"
                    android:layout_marginTop="26dp"
                    android:layout_gravity="center_horizontal"
                    android:textSize="16dp"/>
                <!--
                <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                    android:id="@+id/ganancia"
                    android:layout_width="80dp"
                    android:layout_marginTop="22dp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:layout_height="wrap_content"
                    android:text="300.00"
                    />
                    -->
            </LinearLayout>
        </LinearLayout>



    </com.google.android.material.card.MaterialCardView>





</androidx.constraintlayout.widget.ConstraintLayout>