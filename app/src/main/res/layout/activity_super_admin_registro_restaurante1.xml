<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".SuperAdmin.SuperAdminRegistroRestaurante1">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15sp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/topAppBar"
                style="@style/Widget.MaterialComponents.Toolbar.Primary"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/white"
                app:menu="@menu/top_app_bar_super_admin"
                app:navigationIcon="@drawable/icons8_izquierda_circulo_48"
                app:title="@string/title"
                app:titleTextAppearance="@style/ToolbarTitleStyle"
                app:titleTextColor="@color/light_green" />

        </com.google.android.material.appbar.AppBarLayout>
        <TextView
            android:id="@+id/textView14"
            android:layout_width="match_parent"
            android:layout_height="40sp"
            android:text="Registrar Restaurante"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="30sp"
            android:textStyle="bold"
            />
        <LinearLayout
            android:backgroundTint="#FBF5F0"
            android:id="@+id/linearLayout4"
            android:layout_width="392sp"
            android:layout_height="550sp"
            android:layout_marginTop="15sp"
            android:background="@drawable/border_form"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_anchorGravity="center"
            >

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayout"
                android:layout_width="380sp"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:layout_marginTop="24dp"
                app:startIconDrawable="@drawable/restau"
                >
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/restauranteNombre"
                    android:layout_width="360sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="53sp"
                    android:singleLine="true"
                    android:hint="Nombre del restaurante"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/activity_label"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="0.4"
                android:textColor="@color/black"
                android:text="Categoría del restaurante"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="15sp"
                android:layout_marginTop="10dp"
                android:textStyle="bold"
                android:layout_marginBottom="-20sp"/>

            <Spinner
                android:id="@+id/spinner_categoria"
                android:layout_gravity="center_horizontal"
                android:layout_width="340sp"
                android:layout_height="0sp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:entries="@array/categoria_list"
                android:spinnerMode="dropdown"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="180sp"
                    android:layout_height="80sp"
                    android:padding="10sp"
                    app:startIconDrawable="@drawable/entrar"
                    android:hint="Hora de inicio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hora_inicio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:startIconDrawable="@drawable/restau"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="Selecciona" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="190sp"
                    android:layout_height="80sp"
                    android:padding="10sp"
                    app:startIconDrawable="@drawable/event_busy_24px"
                    android:hint="Hora de cierre">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hora_fin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false"
                        android:text="Selecciona" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_marginTop="20sp"
                    android:layout_width="150sp"
                    android:layout_height="150sp"
                    android:src="@drawable/baseline_file_upload_24" />

                <TextView
                    android:id="@+id/tv_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:textColor="@color/black"
                    android:layout_weight="1"
                    android:text="Subir Logo"
                    android:textSize="15sp"
                    android:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="3dp"
                android:layout_weight="1"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/continuar1"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/light_green"
                    android:onClick="vistaRegistroRestaurante2"
                    android:text="Continuar"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/cancelar1"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/md_theme_error"
                    android:onClick="vistaPanelRestaurante"
                    android:text="Cancelar"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="130sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:menu="@menu/bottom_navigation_superadmin"
        tools:layout_editor_absoluteX="6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
