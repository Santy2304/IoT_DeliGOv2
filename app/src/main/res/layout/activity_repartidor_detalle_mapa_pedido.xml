<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    tools:context=".Repartidor.HomePedidos.RepartidorDetalleMapaPedido">
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="820sp"
        app:layout_constraintTop_toTopOf="@+id/padre"
        app:menu="@menu/cliente_menu" />
    <LinearLayout
        android:id="@+id/padre"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45sp"
            android:layout_marginTop="4sp"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5sp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/icons8_izquierda_circulo_48"
                android:onClick="retroceder"/>
        </LinearLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mapa de pedido #32"
            android:textColor="@color/black"
            android:textSize="35sp"
            android:layout_marginTop="3sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:textAlignment="center"
            />

        <fragment
            android:id="@+id/mapRestaurant"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_marginTop="10sp"
            android:layout_width="370sp"
            android:layout_height="420sp"
            map:cameraZoom="20"
            android:layout_gravity="center_horizontal"
            map:uiRotateGestures="true"
            map:uiZoomControls="true"
            />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20sp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_marginStart="15sp"
                android:layout_width="250sp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="250sp"
                    android:layout_height="match_parent">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Destino Tienda:"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/destinoTienda"
                        android:textColor="@color/black"
                        android:layout_width="130sp"
                        android:layout_marginStart="5sp"
                        android:layout_height="match_parent"
                        android:text="Av.Antonio José Sucre 499"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="10sp"
                    android:orientation="horizontal"
                    android:layout_width="250sp"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="15sp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Destino Final:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        />
                    <TextView
                        android:id="@+id/destinoFinal"
                        android:layout_marginStart="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Destino Tienda: "
                        android:textColor="@color/black"
                        />
                </LinearLayout>

            </LinearLayout>

            <Button
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="155sp"
                android:id="@+id/btn_aceptar"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="-10sp"
                android:backgroundTint="@color/light_green"
                android:text="Aceptar pedido"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                app:iconSize="25sp"
                app:icon="@drawable/intento"
                android:onClick="aceptarPedido"
                />


        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>