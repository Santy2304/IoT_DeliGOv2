<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Administrador.AdministradorHistorialActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/linearLayout11"
            android:layout_width="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView"
                android:layout_gravity="center_vertical"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-condensed-medium"
                android:text="Historial de Pedidos"
                android:textColor="@color/light_green"
                android:textSize="32sp"
                android:textStyle="bold" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/buttonHistorial"
                style="?attr/floatingActionButtonSmallStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="116dp"
                android:layout_marginTop="10dp"
                android:visibility="invisible"
                android:layout_weight="1"
                android:backgroundTint="@color/light_green"
                android:contentDescription="Notificaciones"
                app:srcCompat="@drawable/baseline_history_24"
                app:tint="@color/white" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/shapeableImageView3"
                android:layout_width="0dp"
                android:layout_height="50sp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                android:layout_weight="0.9"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
                app:srcCompat="@drawable/hineilll" />



        </LinearLayout>



        <LinearLayout
            android:id="@+id/linearLayout12"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pendientesButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18sp"
                android:backgroundTint="@color/light_green"
                android:fontFamily="sans-serif-condensed-medium"
                android:paddingLeft="-5sp"
                android:paddingRight="-5sp"
                android:text="Pendientes"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/entregadosButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/dark_green"
                android:fontFamily="sans-serif-condensed-medium"
                android:paddingLeft="-5sp"
                android:paddingRight="-5sp"
                android:text="Entregados"
                android:textSize="13sp"
                app:backgroundTint="@color/md_theme_secondary" />

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistorialAdmin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>
    </LinearLayout>









    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="410sp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_navigation_admin" />

</androidx.constraintlayout.widget.ConstraintLayout>