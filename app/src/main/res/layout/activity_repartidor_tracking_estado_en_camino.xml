<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Repartidor.ProcesosTracking.RepartidorTrackingEstadoEnCamino">


    <LinearLayout
        android:id="@+id/linearLayout15"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5sp"
            android:layout_marginTop="15sp"
            android:onClick="RegresarCrearCuenta2"
            android:src="@drawable/icons8_izquierda_circulo_48" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/noti_button"
            style="?attr/floatingActionButtonSmallStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="240sp"
            android:layout_marginTop="15sp"
            android:backgroundTint="@color/light_green"
            android:contentDescription="Notificaciones"
            android:onClick="vistaNotificaciones"
            app:srcCompat="@drawable/notifications_24px"
            app:tint="@color/white" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/shapeableImageView3"
            android:layout_width="50sp"
            android:layout_height="50sp"
            android:layout_marginStart="8sp"
            android:layout_marginTop="15sp"
            android:onClick="verRepartidorTrackingEstadoEnPreparacion"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundedImageViewRounded"
            app:srcCompat="@drawable/hineilll" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/padre"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout15"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10sp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16sp"
                android:layout_marginTop="5sp"
                android:text="Pedido #32"
                android:textColor="@color/black"
                android:textSize="35sp"
                android:textStyle="bold" />

            <Button
                android:layout_width="190sp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22sp"
                android:layout_marginTop="1sp"
                android:backgroundTint="@color/md_theme_inversePrimary_highContrast"
                android:text="En camino"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <fragment xmlns:android="http://schemas.android.com/apk/res/android"
            android:name="com.google.android.libraries.navigation.SupportNavigationFragment"
            android:id="@+id/navigation_fragment"
            android:layout_width="match_parent"
            android:layout_height="350sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20sp"
            android:layout_weight="2"
            android:orientation="horizontal">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="240sp"
                    android:layout_height="75sp"
                    android:layout_marginStart="18sp"
                    android:background="@drawable/border_form"
                    android:backgroundTint="#FBF5F0"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="220sp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5sp"
                        android:text="Dirección cliente:"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="250sp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5sp"
                        android:layout_marginTop="-4sp"
                        android:text=" Av. Antonio José de Sucre 499"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="240sp"
                    android:layout_height="75sp"
                    android:layout_marginStart="18sp"
                    android:layout_marginTop="-24sp"
                    android:background="@drawable/border_form"
                    android:backgroundTint="#FBF5F0"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="220sp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5sp"
                        android:text="Cliente:"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="250sp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="35sp"
                        android:layout_marginTop="-1sp"
                        android:text="Hineill Céspedes"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="240sp"
                    android:layout_height="75sp"
                    android:layout_marginStart="18sp"
                    android:layout_marginTop="-28sp"
                    android:background="@drawable/border_form"
                    android:backgroundTint="#FBF5F0"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="220sp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5sp"
                        android:text="Celular:"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="250sp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="35sp"
                        android:layout_marginTop="-2sp"
                        android:text="920821483"
                        android:textColor="@color/black"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10sp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="150sp"
                    android:layout_height="50sp"
                    android:layout_marginTop="25sp"
                    android:text="Importante: Escánear el QR del cliente para terminar con el pedido"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="150sp"
                    android:layout_height="60sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="5sp"
                    android:layout_marginTop="10sp"
                    android:backgroundTint="@color/light_green"
                    android:onClick="verSiguienteTracking"
                    android:text="Escánear QR"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:icon="@drawable/qr_icon"
                    app:iconSize="35sp" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="130sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:menu="@menu/cliente_menu"
        tools:layout_editor_absoluteX="6dp" />
</androidx.constraintlayout.widget.ConstraintLayout>