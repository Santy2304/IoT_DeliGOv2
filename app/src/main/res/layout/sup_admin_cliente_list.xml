<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:foregroundGravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgCliente"
                android:layout_width="100sp"
                android:layout_height="100sp"
                android:contentDescription="banner"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/ic_loading" />


            <LinearLayout
                android:layout_width="170dp"
                android:layout_height="90sp"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre: Lancelot del Lago"
                    android:textColor="@color/light_green"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-condensed-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dni"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DNI: 12345678"
                    android:fontFamily="sans-serif-condensed"
                    android:textColor="@color/black"
                     />

                <TextView
                    android:id="@+id/tv_correo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo: cliente@gmail.com"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/black"
                    android:fontFamily="sans-serif-condensed"
                    />
            </LinearLayout>


            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/bt_info"
                style="?attr/floatingActionButtonSmallStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:visibility="visible"
                app:backgroundTint="@color/light_yellow"
                app:srcCompat="@drawable/baseline_eye_24"
                app:tint="@color/white" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/bt_activar"
                    style="?attr/floatingActionButtonSmallStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_gravity="center_vertical"
                    android:visibility="visible"
                    app:backgroundTint="@color/light_green"
                    app:srcCompat="@drawable/baseline_check_circle_24"
                    app:tint="@color/white" />


        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>